{
  "name": "arc-favorites-chrome",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "build": "npm run icons && npm run typecheck && vite build",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "tldts": "^7.0.16"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.36",
    "@types/node": "^24.3.0",
    "jszip": "^3.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
