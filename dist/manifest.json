{
  "manifest_version": 3,
  "name": "Favorites — Arc-style app tabs",
  "short_name": "Favorites",
  "description": "让 Chrome 原生固定标签成为可跨重启恢复的 Arc 风格 Favorites。",
  "version": "0.6.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "scripting",
    "favicon"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "管理 Favorites",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    }
  }
}
